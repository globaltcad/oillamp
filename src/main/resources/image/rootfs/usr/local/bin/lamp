#!/usr/bin/env bash
# lamp: drive the sandbox desktop from a shell, and search the web.
#
# This is deliberately a shell script and deliberately thin. An agent that needs something this
# does not do can call the underlying tools directly (grim, wtype, and the pointer helper
# /usr/local/lib/oillamp/lamp-pointer), and the script says so in its own help. Reading it with
# `cat $(command -v lamp)` is a supported way to find out what it does.
#
# Pointer input (move, click, drag, scroll) goes through lamp-pointer, which talks to the desktop's
# VNC server, the same way the human's viewer does. wlrctl is not used for it: `wlrctl pointer
# move` moves by an offset rather than to a position, and a click from a separate wlrctl call does
# not reach any window. lamp-pointer explains why.
#
# Keyboard input uses wtype with a 150 ms pause before the first key (`-s 150`). Each wtype call
# sends the desktop a new keyboard layout, and X11 applications (Java Swing, for example) drop the
# key that arrives together with it. Without the pause, the first key of every call was lost.
#
# It is also why there is no Java here: a binary the agent cannot read is a worse tool than a
# script it can.

set -Eeuo pipefail

SCREENSHOT_DIR="${HOME}/screenshots"
POINTER="${LAMP_POINTER:-/usr/local/lib/oillamp/lamp-pointer}"
# Where the session on the host listens for `lamp show`.
DESKTOP_SOCKET="${LAMP_DESKTOP_SOCKET:-/oillamp/sockets/host/desktop.sock}"
# The agent's buttons on the dock, and where the dock writes its process id.
DOCK_FILE="${LAMP_DOCK_FILE:-${HOME}/.config/lamp/dock.json}"
DOCK_PID_FILE="${LAMP_DOCK_PID_FILE:-/run/agent/lamp-dock.pid}"
# Milliseconds wtype waits before the first key; see the comment at the top.
KEY_SETTLE_MS=150
# `lamp search`: where SearXNG is installed and its settings, and the directory its socket, its
# log and its caches go in. The agent's runtime directory, /run/agent, is its own (mode 0700) and
# is emptied with the session, as SearXNG's state should be.
SEARXNG_HOME="${LAMP_SEARXNG_HOME:-/opt/searxng}"
SEARXNG_SETTINGS="${LAMP_SEARXNG_SETTINGS:-/etc/searxng/settings.yml}"
SEARCH_DIR="${LAMP_SEARCH_DIR:-${XDG_RUNTIME_DIR:-/run/agent}/searxng}"
# How long SearXNG may take to start answering, in seconds.
SEARCH_START_SECONDS="${LAMP_SEARCH_START_SECONDS:-30}"
# How many results `lamp search` prints unless asked for more or fewer.
SEARCH_COUNT=5

die() { printf 'lamp: %s\n' "$*" >&2; exit 1; }

need() {
    command -v "$1" >/dev/null 2>&1 || die "this needs '$1', which is not installed in this sandbox.
Everything lamp does is a thin wrapper over standard Wayland tools; if one is missing, say so and
the human adds it to image.extra_apt_packages."
}

timestamped() {
    mkdir -p "$SCREENSHOT_DIR"
    printf '%s/%s-%s.png' "$SCREENSHOT_DIR" "$1" "$(date +%Y%m%d-%H%M%S)"
}

cmd_screenshot() {
    need grim
    local region='' output=''
    while [ $# -gt 0 ]; do
        case "$1" in
            --region) [ $# -ge 2 ] || die "--region takes X,Y,W,H (for example 0,0,800,600)"
                      region="$2"; shift 2 ;;
            --out)    [ $# -ge 2 ] || die "--out takes the file to write, for example --out /tmp/shot.png"
                      output="$2"; shift 2 ;;
            *)        die "unknown option for screenshot: $1" ;;
        esac
    done
    [ -n "$output" ] || output=$(timestamped screenshot)
    if [ -n "$region" ]; then
        # grim wants "X,Y WxH"; the friendlier "X,Y,W,H" is what the agent guide documents.
        local x y w h
        IFS=, read -r x y w h <<<"$region"
        [ -n "$h" ] || die "--region takes X,Y,W,H (for example 0,0,800,600)"
        grim -g "$x,$y ${w}x${h}" "$output"
    else
        grim "$output"
    fi
    printf '%s\n' "$output"
}

cmd_click() {
    [ $# -ge 2 ] || die "click takes X and Y"
    "$POINTER" click "$@"
}

cmd_move() { [ $# -ge 2 ] || die "move takes X and Y"; "$POINTER" move "$1" "$2"; }

cmd_drag() { [ $# -ge 4 ] || die "drag takes X1 Y1 X2 Y2"; "$POINTER" drag "$1" "$2" "$3" "$4"; }

# lamp scroll X Y AMOUNT [HORIZONTAL], or lamp scroll AMOUNT [HORIZONTAL] at the last position
# lamp moved the pointer to (the middle of the screen if it never has).
cmd_scroll() {
    [ $# -ge 1 ] || die "scroll takes an amount: lamp scroll [X Y] AMOUNT [HORIZONTAL]"
    if [ $# -ge 3 ]; then
        "$POINTER" scroll "$@"
    else
        local position
        position=$("$POINTER" where)
        [ "$position" = unknown ] && position="$(( ${OILLAMP_DISPLAY_WIDTH:-1920} / 2 )) $(( ${OILLAMP_DISPLAY_HEIGHT:-1080} / 2 ))"
        # shellcheck disable=SC2086
        "$POINTER" scroll $position "$@"
    fi
}

cmd_type() { need wtype; [ $# -ge 1 ] || die "type takes the text to type"; wtype -s "$KEY_SETTLE_MS" -- "$*"; }

cmd_key() {
    need wtype
    [ $# -ge 1 ] || die "key takes a combination such as ctrl+shift+t"
    local combination="$1" args=() part
    # wtype wants each modifier as -M and the final key as -k: ctrl+shift+t is
    # `wtype -M ctrl -M shift -k t`.
    IFS='+' read -ra parts <<<"$combination"
    local last=$(( ${#parts[@]} - 1 )) i=0
    for part in "${parts[@]}"; do
        if [ "$i" -eq "$last" ]; then args+=(-k "$part"); else args+=(-M "$part"); fi
        i=$((i + 1))
    done
    wtype -s "$KEY_SETTLE_MS" "${args[@]}"
}

cmd_wait_stable() {
    need grim
    [[ "${1:-10}" =~ ^[0-9]+$ ]] || die "wait-stable takes a whole number of seconds, for example lamp wait-stable 10"
    # Counted in tenths of a second, so plain shell arithmetic is enough.
    local timeout_ds=$(( ${1:-10} * 10 )) interval_ds=5 elapsed_ds=0 a b
    a=$(mktemp /tmp/lamp-stable-XXXXXX.png); b=$(mktemp /tmp/lamp-stable-XXXXXX.png)
    trap 'rm -f "$a" "$b"' RETURN
    grim "$a"
    while [ "$elapsed_ds" -lt "$timeout_ds" ]; do
        sleep 0.5
        grim "$b"
        # Two identical captures half a second apart means nothing is animating any more. This is
        # cheaper and far more reliable than guessing a fixed sleep after launching an application.
        if cmp -s "$a" "$b"; then printf 'stable\n'; return 0; fi
        mv "$b" "$a"
        elapsed_ds=$(( elapsed_ds + interval_ds ))
    done
    printf 'still changing after %ss\n' "${1:-10}"
    return 1
}

# Asks the user to look at the desktop. The session passes it on to whatever the user watches the
# sandbox from: the app that shows this desktop opens it, the terminal says so. One JSON line goes
# to the session, one comes back; Python writes the JSON, so any text arrives as it was typed.
cmd_show() {
    need python3
    python3 - "$DESKTOP_SOCKET" "$*" <<'PY'
import json, socket, sys
path, what = sys.argv[1], sys.argv[2]
try:
    with socket.socket(socket.AF_UNIX) as connection:
        connection.settimeout(10)
        connection.connect(path)
        connection.sendall((json.dumps({"op": "show", "what": what}) + "\n").encode())
        connection.shutdown(socket.SHUT_WR)
        reply = json.loads(connection.makefile(encoding="utf-8").readline())
except (OSError, ValueError) as failed:
    sys.exit(f"lamp: the session did not answer at {path} ({failed}). The user was not told.")
if not reply.get("ok"):
    sys.exit("lamp: " + reply.get("error", "the session said no, without saying why"))
print(reply.get("text", ""))
PY
}

# The agent's buttons on the dock at the bottom of the desktop. The dock reads the file again
# within a second of a change. It is replaced in one rename, so the dock never reads half of it.
cmd_dock() {
    need python3
    python3 - "$DOCK_FILE" "$DOCK_PID_FILE" "$@" <<'PY'
import json, os, sys, tempfile
path, pid_file, args = sys.argv[1], sys.argv[2], sys.argv[3:]
action = args.pop(0) if args else "list"
usage = "usage: lamp dock [list] | lamp dock add [LABEL] COMMAND [--icon ICON] | lamp dock remove LABEL_OR_COMMAND"

def fail(message):
    sys.exit("lamp: " + message)

def dock_running():
    try:
        with open(pid_file) as file:
            os.kill(int(file.read().strip()), 0)
        return True
    except (OSError, ValueError):
        return False

try:
    with open(path, encoding="utf-8") as file:
        items = json.load(file)
    if not isinstance(items, list):
        raise ValueError("it must hold a list of items")
except FileNotFoundError:
    items = []
except (OSError, ValueError) as unreadable:
    fail(f"{path} cannot be read ({unreadable}). Fix or delete it; lamp dock does not write over it.")

def write():
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=os.path.dirname(path), delete=False) as file:
        json.dump(items, file, indent=2, ensure_ascii=False)
        file.write("\n")
    os.replace(file.name, path)

def name(item):
    return item.get("label") or item.get("command")

def key(item):
    return ("label", item["label"]) if item.get("label") else ("command", item.get("command"))

if action == "add":
    icon = None
    if "--icon" in args:
        at = args.index("--icon")
        if at + 1 >= len(args):
            fail("--icon takes an icon name or an image file")
        icon = args[at + 1]
        del args[at:at + 2]
    if len(args) not in (1, 2) or not all(arg.strip() for arg in args):
        fail(usage)
    if len(args) == 1 and (not icon or not icon.strip()):
        fail("an icon-only button needs --icon ICON")
    item = {"command": args[-1]}
    if len(args) == 2:
        item["label"] = args[0]
    if icon:
        item["icon"] = icon
    replaced = any(key(old) == key(item) for old in items)
    items = [item if key(old) == key(item) else old for old in items]
    if not replaced:
        items.append(item)
    write()
    print(("replaced" if replaced else "added") + f" '{name(item)}' on the dock")
elif action == "remove":
    if len(args) != 1:
        fail(usage)
    # Preserve removal by label when an icon-only command has the same text.
    target = ("label", args[0])
    if not any(key(old) == target for old in items):
        target = ("command", args[0])
    if not any(key(old) == target for old in items):
        fail(f"there is no '{args[0]}' on the dock. `lamp dock` lists what is there.")
    items = [old for old in items if key(old) != target]
    write()
    print(f"removed '{args[0]}' from the dock")
elif action == "list":
    if args:
        fail(usage)
    if not items:
        print("You have no buttons on the dock. The dock's own buttons are always there.")
    for item in items:
        icon = f"  (icon {item['icon']})" if item.get("icon") else ""
        label = f"{item['label']}: " if item.get("label") else ""
        print(f"{label}{item.get('command')}{icon}")
else:
    fail(usage)
if not dock_running():
    print("The dock is not running, so the user does not see these buttons.", file=sys.stderr)
PY
}

# Searches the web through SearXNG, a meta search engine installed in the image, which asks a few
# engines (DuckDuckGo, Brave, Mojeek and others, listed in its settings) and merges their results.
# See docs/WEB-SEARCH.md.
#
# SearXNG is started by the first search, not with the session, so a session that never searches
# pays nothing for it, and is then left running for the next one. It listens on a Unix socket, not
# a port: oillamp offers every port the agent listens on to the user, to open in their browser.
# Talking to a socket also means the request cannot go to the proxy by mistake. Two first searches
# at once take turns at a lock, so the second finds the SearXNG the first one started.
#
# When there are no results, the engines may simply have found nothing, or they may have refused
# to answer: engines block a burst of searches for a while. SearXNG names the engines that failed,
# so `lamp search` can tell the two apart. Nothing found is an answer (exit 0); no results with
# engines failing is an error (exit 1), so that the agent does not conclude that nothing exists.
cmd_search() {
    local count="$SEARCH_COUNT"
    while [ $# -gt 0 ]; do
        case "$1" in
            -n|--count) [ $# -ge 2 ] && [[ "$2" =~ ^[1-9][0-9]*$ ]] \
                            || die "$1 takes how many results to print, a whole number from 1, for example -n 10"
                        count="$2"; shift 2 ;;
            --)         shift; break ;;
            -*)         die "unknown option for search: $1. Usage: lamp search [-n COUNT] \"what to search for\"" ;;
            *)          break ;;
        esac
    done
    [ $# -ge 1 ] && [ -n "${*// /}" ] || die "search takes what to search for: lamp search [-n COUNT] \"what to search for\""
    need python3
    [ -x "$SEARXNG_HOME/venv/bin/python" ] && [ -d "$SEARXNG_HOME/src/searx" ] \
        || die "search is not available: SearXNG, which it asks, is not installed in this image ($SEARXNG_HOME).
It is installed when the image is built, and its install may have failed then. Say so; the human
can rebuild the image."
    # exec: a signal sent to `lamp` reaches the search itself. SearXNG, in a session of its own,
    # is not ended by it.
    exec python3 - "$SEARXNG_HOME" "$SEARXNG_SETTINGS" "$SEARCH_DIR" "$SEARCH_START_SECONDS" "$count" "$*" <<'PY'
import fcntl, http.client, json, os, re, secrets, socket, subprocess, sys, time, urllib.parse
home, settings, directory, start_seconds, count, query = sys.argv[1:]
start_seconds, count = int(start_seconds), int(count)
sock_path = os.path.join(directory, "searxng.sock")
log = os.path.join(directory, "searxng.log")

def fail(message):
    sys.exit("lamp: " + message)

class OverTheSocket(http.client.HTTPConnection):
    def __init__(self, timeout):
        super().__init__("localhost", timeout=timeout)
    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.settimeout(self.timeout)
        self.sock.connect(sock_path)

def get(path, timeout):
    connection = OverTheSocket(timeout)
    try:
        # A client on a socket has no address, so SearXNG's log says "No remote IP could be
        # determined" at every request. That is expected, and harmless with the limiter off.
        connection.request("GET", path)
        response = connection.getresponse()
        return response.status, response.read()
    finally:
        connection.close()

def answering():
    try:
        return get("/healthz", 2)[0] == 200
    except (OSError, http.client.HTTPException):
        return False

def start():
    os.makedirs(directory, mode=0o700, exist_ok=True)
    with open(os.path.join(directory, "start.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if answering():  # another search started it while this one waited for the lock
            return
        # A socket left behind by a SearXNG that ended would stop the new one from listening.
        try:
            os.unlink(sock_path)
        except FileNotFoundError:
            pass
        environment = dict(os.environ,
                           SEARXNG_SETTINGS_PATH=settings,
                           SEARXNG_BIND_ADDRESS="unix://" + sock_path,
                           SEARXNG_SECRET=secrets.token_hex(32),
                           PYTHONPATH=os.path.join(home, "src"),
                           TMPDIR=directory)
        with open(log, "ab") as output:
            output.write(f"--- started by lamp search at {time.strftime('%Y-%m-%d %H:%M:%S')}\n".encode())
            output.flush()
            searxng = subprocess.Popen([os.path.join(home, "venv", "bin", "python"), "-m", "searx.webapp"],
                                       cwd=directory, env=environment, stdin=subprocess.DEVNULL,
                                       stdout=output, stderr=subprocess.STDOUT, start_new_session=True)
        deadline = time.monotonic() + start_seconds
        while not answering():
            if searxng.poll() is not None:
                fail(f"SearXNG, which lamp search asks, ended while starting (exit code {searxng.returncode}).\n"
                     f"Its log says why: {log}")
            if time.monotonic() > deadline:
                searxng.kill()
                fail(f"SearXNG, which lamp search asks, did not answer within {start_seconds} seconds, and was "
                     f"stopped.\nIts log may say why: {log}")
            time.sleep(0.2)

if not answering():
    start()

try:
    status, body = get("/search?" + urllib.parse.urlencode({"q": query, "format": "json"}), 30)
    answer = json.loads(body) if status == 200 else None
except (OSError, http.client.HTTPException, ValueError) as broken:
    fail(f"SearXNG did not answer the search ({broken}). Its log: {log}")
if answer is None:
    fail(f"SearXNG answered the search with HTTP {status}. Its log: {log}")

def one_line(text, limit):
    text = re.sub(r"\s+", " ", text or "").strip()
    return text if len(text) <= limit else text[:limit - 1].rstrip() + "…"

unresponsive = answer.get("unresponsive_engines", [])
failed = ", ".join(f"{engine} ({reason})" for engine, reason in unresponsive)
# A network rule of the lamp that refuses an engine's site answers SearXNG with a 403 naming the
# rule, but SearXNG passes on only "HTTP connection error" (or "proxy error"). The rule itself is
# shown to the human by oillamp, so the agent is told where to look.
cut_off = [engine for engine, reason in unresponsive if "connection error" in reason or "proxy error" in reason]
if cut_off:
    failed += (f"\n{', '.join(cut_off)}: a connection error may also mean that a network rule of this lamp "
               "refuses that engine's site. oillamp shows the human each refusal, with the rule.")
results = answer.get("results", [])[:count]
if not results:
    if failed:
        fail(f"no results, and engines failed: {failed}\n"
             "Engines refuse automated searches for a while after a burst of them. Try again in a few minutes.")
    print(f'No results for "{query}".')
    sys.exit(0)
for number, result in enumerate(results, 1):
    print(f"{number}. {one_line(result.get('title'), 200) or '(no title)'}")
    print(f"   {result.get('url', '')}")
    snippet = one_line(result.get("content"), 300)
    if snippet:
        print(f"   {snippet}")
    print()
if failed:
    print(f"lamp: not every engine answered, so these results may be fewer than usual: {failed}", file=sys.stderr)
PY
}

cmd_info() {
    # The size now, from the desktop itself: the user's viewer may have given the desktop the size
    # of the panel they watch it in. It goes back to its own size when they close that panel.
    local own="${OILLAMP_DISPLAY_WIDTH:-?}x${OILLAMP_DISPLAY_HEIGHT:-?}" now
    now=$("$POINTER" size 2>/dev/null) || now="unknown: the desktop's VNC server did not answer"
    printf 'size       %s\n' "$now"
    [ "$now" = "$own" ] || printf 'own size   %s, which it goes back to when the user stops showing it in a panel\n' "$own"
    printf 'renderer   %s\n' "${OILLAMP_RENDERER:-?}"
    printf 'output     HEADLESS-1\n'
    printf 'screenshots %s\n' "$SCREENSHOT_DIR"
    # No window list: sway's IPC socket is mode 0700 and owned by `lamp`, so the agent cannot
    # ask it anything. That is deliberate: reaching that socket would let the agent run commands as
    # the user that owns the recording. Take a screenshot instead.
    printf '\nTo see what is on screen, use `lamp screenshot`: the window list is not available\n'
    printf 'to you, because sway'"'"'s control socket belongs to another user.\n'
}

usage() {
    cat <<'EOF'
lamp — drive this sandbox's desktop, and search the web.

  lamp screenshot [--region X,Y,W,H] [--out FILE]   capture the screen; prints the path
  lamp click X Y [left|right|middle] [double]       click at screen coordinates
  lamp move X Y                                     move the pointer to X Y
  lamp drag X1 Y1 X2 Y2                             press, move, release
  lamp scroll [X Y] AMOUNT [HORIZONTAL]             scroll; positive is down / right
  lamp type "some text"                             type text
  lamp key ctrl+shift+t                             press a key combination
  lamp wait-stable [SECONDS]                        block until the screen stops changing
  lamp info                                         size, renderer, screenshot directory
  lamp show "what you show"                         ask the user to look at this desktop
  lamp dock                                         list your buttons on the dock
  lamp dock add [LABEL] COMMAND [--icon ICON]       add a button; omit LABEL for an icon-only button
  lamp dock remove LABEL_OR_COMMAND                 remove a button by label, or command if unlabelled
  lamp search [-n COUNT] "what to search for"       search the web; prints titles, links, snippets

The dock is the bar at the bottom of the desktop. A click on a button runs its command as you, in
a login shell; hovering over it shows the command. ICON is an icon name, such as firefox-esr, or
an image file. Icon-only buttons need --icon. Adding the same label (or command for an icon-only
button) replaces it. Your buttons are kept in ~/.config/lamp/dock.json and stay until you remove them.
If a label and an icon-only command have the same text, removal takes the labelled button first.

`lamp search` asks a few search engines through SearXNG and prints the top 5 results, or COUNT.
It fails when there are no results because engines refused to answer: they do that for a while
after a burst of searches.

Coordinates are screen pixels, as in a screenshot; 0,0 is the top-left corner. This works for
Wayland and X11 applications (including Java Swing) alike. A click reports no result: take a
screenshot afterwards to see what it did.

This is a thin wrapper, not a gate. The tools it runs are installed here and you may call them
directly whenever lamp does not do what you need:

  grim -g "0,0 800x600" out.png                       capture a region
  slurp                                               pick a region interactively
  wtype -s 150 -M ctrl -M shift -k t                  press a combination
  /usr/local/lib/oillamp/lamp-pointer click 100 200   pointer input, through the desktop's VNC server

Do not use `wlrctl pointer` for clicking: it moves by an offset rather than to a position, and a
click from a separate wlrctl call does not reach the window.

Read this script with `cat $(command -v lamp)` to see exactly what it runs. If it should do
something it does not, say so — it is one file.
EOF
}

[ $# -ge 1 ] || { usage; exit 2; }
# Not named `command`: bash keeps variables and builtins in separate namespaces so it would
# work, but `command -v` appears three lines up and the reader should not have to know that.
subcommand="$1"; shift
case "$subcommand" in
    screenshot)   cmd_screenshot "$@" ;;
    click)        cmd_click "$@" ;;
    move)         cmd_move "$@" ;;
    drag)         cmd_drag "$@" ;;
    scroll)       cmd_scroll "$@" ;;
    type)         cmd_type "$@" ;;
    key)          cmd_key "$@" ;;
    wait-stable)  cmd_wait_stable "$@" ;;
    info)         cmd_info "$@" ;;
    show)         cmd_show "$@" ;;
    dock)         cmd_dock "$@" ;;
    search)       cmd_search "$@" ;;
    -h|--help|help) usage ;;
    *)            die "unknown command '$subcommand'. Run 'lamp help'." ;;
esac
